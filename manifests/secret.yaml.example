# EXAMPLE ONLY — documents the shape of the `vllm-secrets` Secret.
#
# This file is intentionally named `*.yaml.example` (not `*.yaml`) so that
# `kubectl apply -f manifests/` does NOT apply it. If it ended in `.yaml`, a
# directory apply would overwrite your real Secret with the placeholder token
# below and silently pin the API key to a known value.
#
# The README (Step 5) creates this Secret imperatively with a random token:
#
#   VLLM_API_KEY=$(openssl rand -hex 32)
#   kubectl -n llm create secret generic vllm-secrets \
#     --from-literal=VLLM_API_KEY=$VLLM_API_KEY \
#     --from-literal=HUGGING_FACE_HUB_TOKEN=
#
# Prefer that. Only use this file if you'd rather manage the Secret
# declaratively — copy it to `manifests/secret.yaml` (gitignored), drop in a
# real random token, and `kubectl apply -f manifests/secret.yaml`.
apiVersion: v1
kind: Secret
metadata:
  name: vllm-secrets
  namespace: llm
type: Opaque
stringData:
  VLLM_API_KEY: "REPLACE_WITH_RANDOM_TOKEN"   # e.g. output of `openssl rand -hex 32`
  HUGGING_FACE_HUB_TOKEN: ""  # leave empty unless you're using a gated model
