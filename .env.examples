# Copy to .env (gitignored). One file drives both deploy.sh and the Python
# examples / chatbot.
#
# ── INPUTS (you fill these in) ────────────────────────────────────────────
# Read by ./deploy.sh. LINODE_TOKEN is required to provision; the HF token is
# only needed if you switch --model to a gated model (Llama, Mistral, ...).
LINODE_TOKEN=""
HUGGING_FACE_HUB_TOKEN=""

# CLUSTER_LABEL names this stack. It must be UNIQUE within your Linode account:
# it becomes the LKE cluster name and the "<label>-vllm" firewall name. To run a
# second stack, just change this. deploy.sh pre-flights it and refuses to start
# if the name is already taken.
CLUSTER_LABEL="vllm-lke"

# ── OUTPUTS (deploy.sh writes these for you) ──────────────────────────────
# Read by the examples and the chatbot. `./deploy.sh deploy` (or `env`) pulls
# them straight from the cluster, so you normally don't edit these by hand.
# ENDPOINT must include the scheme (http://). The endpoint is plain HTTP in
# this demo (TLS is left as a prod exercise — see the README Security section).
VLLM_API_KEY=""
ENDPOINT="http://<loadbalancer-ip>"
